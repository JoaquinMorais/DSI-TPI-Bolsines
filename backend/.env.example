# Variables del backend. Copiar a backend/.env (no se commitea).
# Para Docker, el compose usa el .env de la raiz.

# Base de datos SQLite (ruta relativa a la raiz del repo al correr desde ahi)
DATABASE_URL=sqlite+aiosqlite:///./backend/data/bolsines.db

# CORS (frontend)
CORS_ORIGINS=http://localhost:5173

# Usuario de desarrollo
USUARIO_DEV=eb.cba01@example.test

# GPS Tracker (API simulada de la catedra)
GPS_MODELO=xtr4500l
# API key mock publica del modelo XTR-4500L (application.properties del repo
# LiberaeMentis/dsi-api-bolsines). Sin key la API responde 401.
GPS_BASE_URL=http://localhost:8080
GPS_API_KEY=sk_xtr_9F3a7C21bE6d4A10f2c8e5b7d913

# Correo
CORREO_MODO=simulado
CORREO_ARCHIVO=
CORREO_TENANT_ID=
CORREO_CLIENT_ID=
CORREO_CLIENT_SECRET=

# Seed
SEED_PASSWORD_DEV=

# Autenticacion
SECRET_KEY=dev-insecure-secret-change-me-0123456789
ACCESS_TOKEN_MINUTES=30
REFRESH_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
