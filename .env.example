# Copiar a .env (no se commitea). Valores de ejemplo, sin secretos reales.

# Origenes permitidos por CORS (frontend)
CORS_ORIGINS=http://localhost:3020

# Base de datos SQLite (dentro del contenedor, en el volumen)
DB_URL=sqlite+aiosqlite:////app/data/bolsines.db

# GPS Tracker (API simulada de la catedra). Ver docs/06-integraciones.md §1.
GPS_MODELO=XTR-4500L
GPS_BASE_URL=http://localhost:8080
# Una API key por modelo. Los valores reales van en .env, no en este archivo.
GPS_API_KEY_XTR4500L=
GPS_API_KEY_NAVTRACK=
GPS_API_KEY_GEOPULSE=

# Contrasena de desarrollo para los usuarios del seed (docs/08-datos-semilla.md)
SEED_PASSWORD_DEV=

# Servidor de correo (Microsoft Graph): pendiente de credenciales
CORREO_TENANT_ID=
CORREO_CLIENT_ID=
CORREO_CLIENT_SECRET=
